---
interface Props {
  id: string;
  labels?: boolean;
}

const { id, labels = false } = Astro.props;
const options = [
  { value: 'light', label: 'Light', icon: 'M12 4V2m0 20v-2m8-8h2M2 12h2m13.66-5.66 1.41-1.41M4.93 19.07l1.41-1.41m0-11.32L4.93 4.93m14.14 14.14-1.41-1.41M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z' },
  { value: 'system', label: 'Device', icon: 'M4 5h16v11H4zM9 20h6m-3-4v4' },
  { value: 'dark', label: 'Dark', icon: 'M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z' },
];
---

<fieldset class="theme-toggle">
  <legend class="sr-only">Colour theme</legend>
  {
    options.map((o) => (
      <label title={o.label}>
        <input type="radio" name={`theme-${id}`} value={o.value} checked={o.value === 'system'} data-theme-option />
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d={o.icon} />
        </svg>
        <span class={labels ? 'text-sm font-medium' : 'sr-only'}>{o.label}</span>
      </label>
    ))
  }
</fieldset>

<script>
  const colours = { light: '#f2ede3', dark: '#0f1a14' };

  const read = () => {
    try {
      const stored = localStorage.getItem('theme');
      return stored === 'light' || stored === 'dark' ? stored : 'system';
    } catch {
      return 'system';
    }
  };

  const apply = (choice: string) => {
    const root = document.documentElement;
    if (choice === 'system') delete root.dataset.theme;
    else root.dataset.theme = choice;
    document.querySelectorAll<HTMLInputElement>('[data-theme-option]').forEach((input) => {
      input.checked = input.value === choice;
    });
    document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]').forEach((meta) => {
      const scheme = meta.media.includes('dark') ? 'dark' : 'light';
      meta.content = colours[choice === 'system' ? scheme : (choice as 'light' | 'dark')];
    });
  };

  apply(read());

  document.addEventListener('change', (event) => {
    const input = event.target;
    if (!(input instanceof HTMLInputElement) || !input.matches('[data-theme-option]')) return;
    try {
      if (input.value === 'system') localStorage.removeItem('theme');
      else localStorage.setItem('theme', input.value);
    } catch {
      // Storage can be blocked; the choice still applies to this page.
    }
    apply(input.value);
  });
</script>
