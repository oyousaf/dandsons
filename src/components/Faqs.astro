---
import type { Faq } from '../lib/content';

interface Props {
  faqs: Faq[];
  heading?: string;
}

const { faqs, heading = 'Common questions' } = Astro.props;
---

{
  faqs.length > 0 && (
    <section class="wrap py-14 md:py-20" aria-labelledby="faq-heading">
      <div class="grid gap-8 md:grid-cols-12">
        <h2 id="faq-heading" class="text-section md:col-span-4">
          {heading}
        </h2>
        <div class="border-t border-ink md:col-span-8">
          {faqs.map((f) => (
            <details class="group border-b border-rule">
              <summary class="flex min-h-14 items-center justify-between gap-6 py-3 text-lg font-semibold [&::-webkit-details-marker]:hidden list-none">
                {f.q}
                <span aria-hidden="true" class="shrink-0 font-mono text-xl text-accent group-open:rotate-45 motion-safe:transition-transform">
                  +
                </span>
              </summary>
              <div class="copy pb-5" set:html={`<p>${f.a}</p>`} />
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}
