---
import { business, primaryNav, serviceGroups } from '../lib/site';
import ThemeToggle from './ThemeToggle.astro';
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const inServices = serviceGroups.some((g) => path.startsWith(g.href));
const current = (href: string) => (path === href || path.startsWith(`${href}/`) ? 'page' : undefined);
---

<header class="sticky top-0 z-40 border-b border-rule bg-ground">
  <div class="wrap flex h-19 items-center justify-between gap-4">
    <a href="/" class="shrink-0" aria-label="Daniel & Son Gardening & Landscaping, home">
      <img src="/logo.png" alt="" width="300" height="83" class="logo-for-light h-10 sm:h-12 w-auto" />
      <img src="/logo-light.png" alt="" width="300" height="83" class="logo-for-dark h-10 sm:h-12 w-auto" />
    </a>

    <nav aria-label="Main" class="hidden items-center gap-1 lg:flex">
      <button
        type="button"
        popovertarget="services-menu"
        class:list={['flex min-h-11 items-center gap-2 px-3 font-medium hover:text-accent', inServices && 'underline decoration-2 underline-offset-8']}
      >
        Services
        <svg aria-hidden="true" width="12" height="8" viewBox="0 0 12 8" fill="none"><path d="M1 1.5l5 5 5-5" stroke="currentColor" stroke-width="1.75"></path></svg>
      </button>
      {
        primaryNav.map((item) => (
          <a
            href={item.href}
            aria-current={current(item.href)}
            class="flex min-h-11 items-center px-3 font-medium hover:text-accent aria-[current=page]:underline aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-8"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2 sm:gap-3 xl:gap-4">
      <div class="hidden lg:block"><ThemeToggle id="desktop" /></div>
      <a href={`tel:${business.phones[0].tel}`} class="hidden min-h-11 items-center font-mono text-sm xl:flex hover:text-accent">
        {business.phones[0].display}
      </a>
      <a href="/bedford-garden-quote" class="btn btn-primary hidden min-h-11! py-1.5! sm:inline-flex">Get a quote</a>
      <button type="button" id="menu-open" class="flex min-h-11 min-w-11 items-center justify-center gap-2 px-2 font-medium lg:hidden" aria-haspopup="dialog">
        <svg aria-hidden="true" width="22" height="14" viewBox="0 0 22 14" fill="none"><path d="M0 1h22M0 7h22M0 13h22" stroke="currentColor" stroke-width="1.75"></path></svg>
        Menu
      </button>
    </div>
  </div>

  <div id="services-menu" popover class="menu-panel">
    <div class="wrap grid grid-cols-5 gap-8 py-8">
      {
        serviceGroups.map((g) => (
          <div>
            <a href={g.href} class="font-display text-2xl hover:text-accent">
              {g.label}
            </a>
            {g.children.length > 0 ? (
              <ul class="mt-3 grid gap-1">
                {g.children.map((c) => (
                  <li>
                    <a href={c.href} class="block py-1 text-[0.9375rem] hover:text-accent hover:underline">
                      {c.label}
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="mt-3 text-[0.9375rem] text-muted">{g.line}</p>
            )}
          </div>
        ))
      }
    </div>
  </div>

  <dialog id="menu-sheet" class="menu-sheet" aria-label="Site menu">
    <div class="flex h-19 items-center justify-between border-b border-rule px-4 sm:px-8">
      <img src="/logo.png" alt="" width="300" height="83" class="logo-for-light h-10 w-auto" />
      <img src="/logo-light.png" alt="" width="300" height="83" class="logo-for-dark h-10 w-auto" />
      <button type="button" id="menu-close" class="flex min-h-11 min-w-11 items-center justify-center px-2 font-medium">Close</button>
    </div>
    <nav aria-label="Mobile" class="px-4 pt-4 pb-10 sm:px-8">
      <ul class="divide-y divide-rule border-b border-rule">
        {
          serviceGroups.map((g) =>
            g.children.length ? (
              <li>
                <details>
                  <summary class="flex min-h-14 items-center justify-between font-display text-2xl">{g.label}</summary>
                  <ul class="grid gap-1 pb-4">
                    <li>
                      <a href={g.href} class="block py-2 font-semibold underline underline-offset-4">
                        All {g.label.toLowerCase()} services
                      </a>
                    </li>
                    {g.children.map((c) => (
                      <li>
                        <a href={c.href} class="block py-2">
                          {c.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            ) : (
              <li>
                <a href={g.href} class="flex min-h-14 items-center font-display text-2xl">
                  {g.label}
                </a>
              </li>
            ),
          )
        }
        {
          primaryNav.map((item) => (
            <li>
              <a href={item.href} class="flex min-h-14 items-center font-display text-2xl">
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/contact" class="flex min-h-14 items-center font-display text-2xl">Contact</a>
        </li>
      </ul>
      <a href="/bedford-garden-quote" class="btn btn-primary mt-6 w-full">Get a free quote</a>
      <div class="mt-6 flex items-center justify-between gap-4 border-t border-rule pt-5">
        <span class="font-semibold">Theme</span>
        <ThemeToggle id="mobile" labels />
      </div>
    </nav>
  </dialog>
</header>

<script>
  const sheet = document.getElementById('menu-sheet') as HTMLDialogElement | null;
  document.getElementById('menu-open')?.addEventListener('click', () => sheet?.showModal());
  document.getElementById('menu-close')?.addEventListener('click', () => sheet?.close());
</script>
