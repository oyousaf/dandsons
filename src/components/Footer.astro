---
import { business, serviceGroups } from '../lib/site';
const year = new Date().getFullYear();
---

<footer class="on-deep bg-deep text-on-deep">
  <div class="wrap grid gap-10 py-14 md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <img src="/logo-light.png" alt="Daniel & Son Gardening & Landscaping" width="300" height="83" loading="lazy" class="h-11 w-auto" />
      <p class="mt-5 max-w-sm text-on-deep/90">A family-run landscaping team working within {business.radiusMiles} miles of Bedford.</p>
      <p class="mt-4 spec text-mint">{business.hours}</p>
    </div>

    <nav aria-label="Services" class="md:col-span-2">
      <h2 class="spec font-mono! text-mint">Services</h2>
      <ul class="mt-4 grid gap-1">
        {
          serviceGroups.map((g) => (
            <li>
              <a href={g.href} class="inline-block py-1 hover:underline">
                {g.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label="Company" class="md:col-span-2">
      <h2 class="spec font-mono! text-mint">Company</h2>
      <ul class="mt-4 grid gap-1">
        <li><a href="/our-works" class="inline-block py-1 hover:underline">Our work</a></li>
        <li><a href="/garden-cost-calculator" class="inline-block py-1 hover:underline">Cost estimator</a></li>
        <li><a href="/areas-covered-bedford" class="inline-block py-1 hover:underline">Areas covered</a></li>
        <li><a href="/blog-list" class="inline-block py-1 hover:underline">Guides</a></li>
        <li><a href="/About-Us" class="inline-block py-1 hover:underline">About us</a></li>
        <li><a href="/contact" class="inline-block py-1 hover:underline">Contact</a></li>
      </ul>
    </nav>

    <div class="md:col-span-4">
      <h2 class="spec font-mono! text-mint">Talk to us</h2>
      <ul class="mt-4 grid gap-1">
        {
          business.phones.map((p) => (
            <li>
              <a href={`tel:${p.tel}`} class="inline-block py-1 font-display text-2xl hover:underline">
                {p.display}
              </a>
            </li>
          ))
        }
        <li><a href={`mailto:${business.email}`} class="inline-block py-1 break-all underline underline-offset-4">{business.email}</a></li>
      </ul>
      <address class="mt-3 text-on-deep/90 not-italic">{business.address.street}, {business.address.village}, {business.address.town}</address>
      <ul class="mt-4 flex flex-wrap gap-x-4">
        {
          business.social.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer" class="inline-block py-1 underline underline-offset-4">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-on-deep/25">
    <div class="wrap flex flex-col gap-2 py-5 pb-24 text-sm text-on-deep/90 lg:flex-row lg:items-center lg:justify-between lg:pb-5">
      <p>
        © {year} {business.name}. <a href="/privacy" class="underline underline-offset-4">Privacy</a>
      </p>
      <p>Unofficial design concept. Not affiliated with or endorsed by {business.name}.</p>
      <p>
        Built with <span class="inline-block motion-safe:animate-heartbeat" role="img" aria-label="love">💚</span> by{' '}
        <a href="https://legxcysol.dev" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4">Legxcy Solutions</a>
      </p>
    </div>
  </div>
</footer>

<nav aria-label="Quick contact" class="on-deep fixed inset-x-0 bottom-0 z-30 grid grid-cols-3 border-t border-on-deep/25 bg-deep text-sm font-semibold text-on-deep sm:hidden">
  <a href={`tel:${business.phones[0].tel}`} class="flex min-h-14 items-center justify-center">Call</a>
  <a href={business.whatsapp} target="_blank" rel="noopener noreferrer" class="flex min-h-14 items-center justify-center border-x border-on-deep/25">WhatsApp</a>
  <a href="/bedford-garden-quote" class="flex min-h-14 items-center justify-center bg-mint text-on-mint">Get a quote</a>
</nav>
