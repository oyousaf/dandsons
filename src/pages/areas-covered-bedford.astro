---
import AreaMap from '../components/AreaMap.astro';
import CtaBand from '../components/CtaBand.astro';
import Base from '../layouts/Base.astro';
import { business } from '../lib/site';

const areas = [
  { heading: 'Main towns', text: 'Our full range of landscaping services, including garden design, decking, fencing and turf, for homes and commercial spaces.', places: ['Bedford', 'Kempston', 'Ampthill', 'Flitwick', 'Woburn Sands', 'Cranfield', 'Biggleswade', 'Sandy'] },
  { heading: 'Villages', text: 'We regularly work in these communities, with reliable garden maintenance, decking and fencing suited to British weather.', places: ['Bromham', 'Elstow', 'Clapham', 'Wootton', 'Marston Moretaine', 'Wilstead', 'Sharnbrook', 'Turvey', 'Oakley', 'Felmersham'] },
  { heading: 'Smaller villages and hamlets', text: 'Rural spots matter too. Access can be different, and we plan the work around it.', places: ['Little Barford', 'Odell', 'Blunham', 'Renhold', 'Colesden'] },
];
---

<Base title="Areas We Cover | Landscaping Across Bedfordshire | Daniel & Son" description={`Patios, decking, fencing, turf and garden care within ${business.radiusMiles} miles of Bedford, including Kempston, Ampthill, Flitwick, Biggleswade and Sandy.`} crumbs={[{ label: 'Areas', href: '/areas-covered-bedford' }]}>
  <section class="wrap grid gap-10 pt-6 pb-14 lg:grid-cols-12 lg:items-center md:pb-20">
    <div class="lg:col-span-6">
      <h1 class="text-section">Within {business.radiusMiles} miles of Bedford, and often further.</h1>
      <p class="mt-5 max-w-xl text-lg">We travel throughout Bedfordshire and into neighbouring counties. Even if your area isn't listed, we probably cover it, so please ask.</p>
      <a href="/bedford-garden-quote" class="btn btn-primary mt-7">Get a free quote</a>
    </div>
    <div class="lg:col-span-6">
      <div class="mx-auto max-w-xl border-5 border-rule bg-ground p-3">
        <AreaMap />
      </div>
    </div>
  </section>

  <section class="border-t border-rule bg-surface">
    <div class="wrap divide-y divide-rule py-6">
      {
        areas.map((a) => (
          <div class="grid gap-5 py-9 lg:grid-cols-12">
            <div class="lg:col-span-5">
              <h2 class="text-title">{a.heading}</h2>
              <p class="mt-3 max-w-md text-muted">{a.text}</p>
            </div>
            <ul class="flex flex-wrap content-start gap-2 lg:col-span-7">
              {a.places.map((p) => (
                <li class="border border-rule bg-ground px-3 py-1.5">{p}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <CtaBand heading="Not sure if we cover you?" text="Call us or send your details. We'll confirm coverage and give you a free, no-obligation quote." />
</Base>
