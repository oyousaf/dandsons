---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Daniel & Son Landscaping" description="This page could not be found.">
  <section class="wrap py-20 md:py-32">
    <p class="spec text-muted">404</p>
    <h1 class="mt-4 max-w-3xl text-section">This path doesn't lead anywhere.</h1>
    <p class="mt-5 max-w-xl text-lg">The page may have moved. Try our services, or have a look at recent work.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="btn btn-primary">Back to home</a>
      <a href="/our-works" class="btn btn-ghost">See our work</a>
    </div>
  </section>
</Base>
