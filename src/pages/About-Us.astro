---
import CtaBand from '../components/CtaBand.astro';
import Photo from '../components/Photo.astro';
import Base from '../layouts/Base.astro';
import { reviews } from '../lib/content';
import { business } from '../lib/site';

const reasons = [
  ['Quality', 'Fully insured, experienced and equipped with professional tools.'],
  ['Bespoke', 'Every garden is tailored to your goals, your style and your budget.'],
  ['Reliable', 'Known for clear communication, turning up on time and excellent craftsmanship.'],
  ['Responsible', 'Sustainable materials where possible and responsible waste handling. We are registered waste carriers.'],
];
const offers = [
  ['Garden makeovers', 'Full redesigns, new layouts and feature installations.'],
  ['Patios and decking', 'Porcelain, sandstone, block paving, timber decking and more.'],
  ['Fencing and gates', 'Durable, secure and good to look at.'],
  ['Artificial grass and turfing', 'Ideal for families and low-maintenance gardens.'],
  ['Pressure washing', 'Patios, driveways, paths and outdoor surfaces brought back to life.'],
  ['Maintenance and clearance', 'Regular upkeep or one-off tidy-ups.'],
];
const quote = reviews.find((r) => r.name === 'Elliot');
---

<Base title="About Us | Daniel & Son Landscaping" description="A family-run landscaping team in Bedford, working across Bedfordshire. High-quality garden work with a personal touch." crumbs={[{ label: 'About', href: '/About-Us' }]}>
  <section class="wrap grid gap-10 pt-6 pb-14 lg:grid-cols-12 lg:items-center lg:gap-14 lg:pb-20">
    <div class="lg:col-span-6">
      <h1 class="text-hero">A father and son who take gardens personally.</h1>
    </div>
    <div class="lg:col-span-6">
      <div class="laid">
        <div class="flag aspect-3/2">
          <Photo name="aboutus-1200.webp" alt="Finished garden landscaping by Daniel & Son" sizes="(min-width: 64rem) 45vw, 100vw" eager />
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-rule bg-surface">
    <div class="wrap grid gap-8 py-14 md:py-20 lg:grid-cols-12">
      <h2 class="text-section lg:col-span-5">Our story</h2>
      <div class="copy text-lg lg:col-span-7">
        <p>Our journey began with a simple mission: to provide high-quality landscaping and garden services with a personal, family-run touch.</p>
        <p>At Daniel & Son, every project is treated as if it were for our own home, with care, craftsmanship and attention to detail. Our aim is to turn outdoor spaces into beautiful, practical areas that add value and joy, and to keep up with what's new in landscaping so the results last.</p>
        <p>As a local Bedford business, we understand the needs of gardens across the region, and we work throughout Bedford, Kempston, Biggleswade, Clapham, Oakley and the surrounding towns.</p>
      </div>
    </div>
  </section>

  <section class="wrap py-14 md:py-20" aria-labelledby="why-heading">
    <h2 id="why-heading" class="text-section">Why people choose us</h2>
    <ul class="laid mt-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        reasons.map(([title, text]) => (
          <li class="flag p-6">
            <h3 class="font-display text-title font-normal">{title}</h3>
            <p class="mt-3 text-muted">{text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  {
    quote && (
      <section class="on-band bg-band text-on-band">
        <figure class="wrap py-16 md:py-24">
          <blockquote class="max-w-5xl font-display text-section">"{quote.text}"</blockquote>
          <figcaption class="mt-6 font-semibold">{quote.name}, Google review</figcaption>
        </figure>
      </section>
    )
  }

  <section class="wrap py-14 md:py-20" aria-labelledby="offer-heading">
    <div class="grid gap-8 lg:grid-cols-12">
      <h2 id="offer-heading" class="text-section lg:col-span-5">What we offer</h2>
      <dl class="border-t border-ink lg:col-span-7">
        {
          offers.map(([title, text]) => (
            <div class="grid gap-1 border-b border-rule py-4 sm:grid-cols-2 sm:gap-6">
              <dt class="font-semibold">{title}</dt>
              <dd class="text-muted">{text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <CtaBand heading="Let's create your dream garden." text={`Whether it's a garden makeover, a new patio, fencing or ongoing maintenance, ${business.short} is here to help.`} />
</Base>
