---
import CtaBand from '../components/CtaBand.astro';
import Photo from '../components/Photo.astro';
import Base from '../layouts/Base.astro';
import { posts } from '../lib/content';

const [latest, ...others] = posts;
const excerpt = (html: string) => html.replace(/<[^>]+>/g, '');
const firstText = (p: (typeof posts)[number]) => {
  const para = p.blocks.find((b) => b.t === 'p');
  return para && 'x' in para ? excerpt(para.x) : p.description;
};
---

<Base title="Garden Guides & Landscaping Advice | Daniel & Son" description="Practical guides on patios, decking, drainage, sealing and seasonal garden care from a Bedfordshire landscaping team." crumbs={[{ label: 'Guides', href: '/blog-list' }]}>
  <section class="wrap pt-6 pb-10">
    <h1 class="max-w-4xl text-section">Practical advice from people who do this for a living.</h1>
  </section>

  <section class="wrap pb-16 md:pb-24">
    <a href={`/blog/${latest.slug}`} class="group grid gap-6 border-y border-ink py-8 lg:grid-cols-12 lg:items-center lg:gap-12">
      <div class="aspect-3/2 overflow-hidden lg:col-span-6">
        <Photo name={latest.hero} alt="" sizes="(min-width: 64rem) 45vw, 100vw" eager class="h-full w-full object-cover" />
      </div>
      <div class="lg:col-span-6">
        <p class="spec text-muted">Latest guide, {latest.date}</p>
        <h2 class="mt-3 text-section group-hover:text-accent">{latest.title}</h2>
        <p class="mt-4 max-w-xl text-lg">{firstText(latest)}</p>
      </div>
    </a>

    <ul class="mt-2 divide-y divide-rule">
      {
        others.map((p) => (
          <li>
            <a href={`/blog/${p.slug}`} class="group grid gap-4 py-6 sm:grid-cols-12 sm:items-center sm:gap-8">
              <div class="aspect-3/2 overflow-hidden sm:col-span-3">
                <Photo name={p.hero} alt="" sizes="(min-width: 40rem) 22vw, 100vw" class="h-full w-full object-cover" />
              </div>
              <div class="sm:col-span-9">
                <p class="spec text-muted">{p.date}</p>
                <h2 class="mt-1 text-title group-hover:text-accent">{p.title}</h2>
                <p class="mt-2 line-clamp-2 max-w-3xl text-muted">{firstText(p)}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <CtaBand />
</Base>
