---
import QuoteForm from '../components/islands/QuoteForm';
import Base from '../layouts/Base.astro';
import { business } from '../lib/site';
---

<Base title="Contact Us | Daniel & Son Landscaping" description="Call, WhatsApp or email Daniel & Son Landscaping in Bedford, or send your garden details for a free, no-obligation quote." crumbs={[{ label: 'Contact', href: '/contact' }]}>
  <section class="wrap grid gap-12 pt-6 pb-16 lg:grid-cols-12 md:pb-24">
    <div class="lg:col-span-5">
      <h1 class="text-section">Talk to us about your garden.</h1>
      <p class="mt-5 text-lg">Whether you have a question, need a quote or just want a chat about what's possible, we're happy to help.</p>
      <dl class="mt-8 border-t border-ink">
        <div class="border-b border-rule py-4">
          <dt class="spec text-muted">Phone</dt>
          <dd class="mt-1 grid gap-1">
            {business.phones.map((p) => <a href={`tel:${p.tel}`} class="inline-block py-0.5 font-display text-title hover:text-accent">{p.display}</a>)}
          </dd>
        </div>
        <div class="border-b border-rule py-4">
          <dt class="spec text-muted">WhatsApp</dt>
          <dd class="mt-1"><a href={business.whatsapp} target="_blank" rel="noopener noreferrer" class="text-link inline-block py-1">Send us a message</a></dd>
        </div>
        <div class="border-b border-rule py-4">
          <dt class="spec text-muted">Email</dt>
          <dd class="mt-1"><a href={`mailto:${business.email}`} class="text-link inline-block py-1 break-all">{business.email}</a></dd>
        </div>
        <div class="border-b border-rule py-4">
          <dt class="spec text-muted">Address</dt>
          <dd class="mt-1"><address class="not-italic">{business.address.street}, {business.address.village}, {business.address.town}</address></dd>
        </div>
        <div class="border-b border-rule py-4">
          <dt class="spec text-muted">Hours</dt>
          <dd class="mt-1">{business.hours}</dd>
        </div>
      </dl>
    </div>
    <div class="lg:col-span-7">
      <div class="border-5 border-rule bg-surface p-5 sm:p-8">
        <h2 class="text-title">Request a free quote</h2>
        <div class="mt-6">
          <QuoteForm client:visible />
        </div>
      </div>
    </div>
  </section>
</Base>
